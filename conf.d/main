#!/bin/sh -ex

# enable webroot
lighty-enable-mod tkl-webroot

# Trixie packages mysqltuner. Discard the mutable upstream copies downloaded
# by the inherited MySQL profile so the installed command remains APT-managed.
rm -f /usr/local/bin/mysqltuner \
      /usr/local/bin/basic_passwords.txt \
      /usr/local/bin/vulnerabilities.csv
